# Copy to .env for local runs. On a cloud host, set these as environment variables instead.

# Discord Developer Portal -> your app -> Bot -> Reset Token
DISCORD_TOKEN=
# Discord Developer Portal -> your app -> General Information -> Application ID
DISCORD_CLIENT_ID=
# Optional: a server ID to register commands there instantly while testing.
# Leave empty to register commands globally (all servers the bot is in).
DISCORD_GUILD_ID=

# MongoDB Atlas -> Connect -> Drivers -> connection string
MONGODB_URI=
MONGODB_DB=f1league
